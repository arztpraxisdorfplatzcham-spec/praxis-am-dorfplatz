---
import Basis from '../../layouts/Basis.astro'
import Startseite from '../../components/Startseite.astro'
import {ladePraxisDaten, t} from '../../lib/sanity'

const d = await ladePraxisDaten()
---

<Basis
  titel={t(d.seoTitel, 'ru') || `${d.praxisName} — семейный врач в ${d.plzOrt?.replace(/^\d+\s*/, '')}`}
  beschreibung={t(d.seoBeschreibung, 'ru')}
  telefon={d.telefon}
  strasse={d.strasse}
  plzOrt={d.plzOrt}
  daten={d}
  lang="ru"
>
  <Startseite daten={d} lang="ru" />
</Basis>
